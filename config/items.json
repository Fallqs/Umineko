            },
            {
              "op": "log_event",
              "event_type": "ACTION",
              "message": "{role} 赠送兔子玩偶给 {target}"
            }
          ]
        }
      ],
      "default_visibility": "hidden"
    },
    {
      "id": "lucky_charm",
      "name": "护身符",
      "type": "consumable",
      "description": "一个绣着六轩岛纹章的小小护身符，据说能带来好运",
      "player_desc": "你握着这个温热的护身符，感到一丝安心。",
      "gm_desc": "来自神社的旧护身符。赠送可解除对方恐惧，但只能使用一次。",
      "location": "神社",
      "day_available": 2,
      "granted_actions": [
        {
          "id": "use",
          "name": "使用护身符",
          "ap_cost": 1,
          "target_type": "none",
          "priority": 70,
          "steps": [
            {
              "op": "consume_item"
            },
            {
              "op": "grant_buff",
              "buff_id": "encouraged",
              "duration": 2
            },
            {
              "op": "notify_self",
              "title": "护身符",
              "body": "你使用了护身符，感到一股温暖的力量涌上心头。（获得【受到鼓舞】）",
              "severity": "info"
            },
            {
              "op": "log_event",
              "event_type": "ACTION",
              "message": "{role} 使用了护身符"
            }
          ]
        },
        {
          "id": "gift",
          "name": "赠送护身符",
          "ap_cost": 1,
          "target_type": "role",
          "priority": 50,
          "steps": [
            {
              "op": "check_target_alive",
              "error_msg": "{target} 已死亡或不在场。"
            },
            {
              "op": "consume_item"
            },
            {
              "op": "remove_buff",
              "target": "{target}",
              "buff_id": "terrified"
            },
            {
              "op": "grant_buff",
              "target": "{target}",
              "buff_id": "encouraged",
              "duration": 2
            },
            {
              "op": "notify_target",
              "title": "收到护身符",
              "body": "【{role}】将护身符赠予你，恐惧消散，你感到受到鼓舞。",
              "severity": "info"
            },
            {
              "op": "notify_self",
              "title": "赠送",
              "body": "你将护身符赠给了 {target}，愿它保佑对方。",
              "severity": "info"
            },
            {
              "op": "log_event",
              "event_type": "ACTION",
              "message": "{role} 赠送护身符给 {target}"
            }
          ]
        }
      ],
      "default_visibility": "hidden"
    },
