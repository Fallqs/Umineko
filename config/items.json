{
  "_comment": "物品注册表。每个 item_id 对应唯一的物品实例。granted_actions 使用元行动(op)组合定义行为。",
  "items": [
    {
      "id": "revolver",
      "name": "左轮手枪",
      "type": "permanent",
      "description": "一把老旧的左轮手枪，表面有轻微的磨损痕迹",
      "player_desc": "你握着这把沉甸甸的左轮手枪。转轮可以顺畅地转动，枪身保养良好。",
      "gm_desc": "一把.38口径左轮手枪，6发弹巢。金藏的收藏品之一。",
      "location": "书房",
      "day_available": 1,
      "initial_state": {
        "ammo": 6
      },
      "granted_actions": [
        {
          "id": "shoot",
          "name": "射击",
          "ap_cost": 5,
          "target_type": "role",
          "priority": 100,
          "steps": [
            {
              "op": "check_target_alive",
              "error_msg": "{target} 已死亡或不在场"
            },
            {
              "op": "check_item_state",
              "key": "ammo",
              "condition": ">0",
              "error_msg": "枪膛空空如也"
            },
            {
              "op": "consume_item_state",
              "key": "ammo",
              "delta": -1
            },
            {
              "op": "broadcast",
              "message": "突然掏出了枪！",
              "exclude_self": true
            },
            {
              "op": "notify_self",
              "title": "射击",
              "body": "你向 {target} 开枪了！（剩余 {item_state.ammo} 发）",
              "severity": "error"
            },
            {
              "op": "log_event",
              "event_type": "ACTION",
              "message": "{role} 向 {target} 开枪"
            }
          ],
          "on_failure": {
            "steps": [
              {
                "op": "notify_self",
                "title": "射击",
                "body": "你扣动扳机，但枪膛空空如也。你仍然可以用枪威胁对方。",
                "severity": "warning"
              }
            ]
          }
        },
        {
          "id": "threaten",
          "name": "威胁",
          "ap_cost": 1,
          "target_type": "role",
          "priority": 50,
          "steps": [
            {
              "op": "broadcast",
              "message": "{role} 用武器指着 {target}！",
              "exclude_self": true
            },
            {
              "op": "notify_self",
              "title": "威胁",
              "body": "你用武器指着 {target}，气氛紧张。",
              "severity": "warning"
            },
            {
              "op": "log_event",
              "event_type": "ACTION",
              "message": "{role} 威胁 {target}"
            }
          ]
        }
      ],
      "default_visibility": "hidden"
    },
    {
      "id": "poison_bottle",
      "name": "毒药瓶",
      "type": "consumable",
      "description": "一个贴着标签的小瓶子，里面装着无色液体",
      "player_desc": "你手中握着这瓶毒药。标签上写着'氰化物'——一滴就足以致命。",
      "gm_desc": "高纯度氰化物溶液。来自地下密室的储备，总量约10ml。",
      "location": "地下密室",
      "day_available": 3,
      "granted_actions": [
        {
          "id": "use",
          "name": "使用毒药",
          "ap_cost": 1,
          "target_type": "role",
          "priority": 80,
          "steps": [
            {
              "op": "consume_item"
            },
            {
              "op": "notify_self",
              "title": "使用",
              "body": "你将毒药混入了饮料中...",
              "severity": "error"
            },
            {
              "op": "log_event",
              "event_type": "ACTION",
              "message": "{role} 使用了毒药"
            }
          ]
        }
      ],
      "default_visibility": "hidden"
    },
    {
      "id": "diary_1986",
      "name": "金藏的日记",
      "type": "permanent",
      "description": "一本封面写着'1986'的旧日记，上着一把小锁",
      "player_desc": "你翻开这本日记，纸张已经发黄。里面记录着金藏对'黄金魔女'的研究。",
      "gm_desc": "金藏从1986年开始的研究笔记，包含三代贝阿朵的身份线索。",
      "location": "书房",
      "day_available": 1,
      "granted_actions": [
        {
          "id": "use",
          "name": "阅读日记",
          "ap_cost": 1,
          "target_type": "none",
          "priority": 70,
          "steps": [
            {
              "op": "unlock_info",
              "info_id": "S-金藏日记"
            },
            {
              "op": "unlock_info",
              "info_id": "C-金藏遗书"
            },
            {
              "op": "notify_self",
              "title": "阅读日记",
              "body": "你仔细阅读了金藏的日记，发现了关于黄金魔女的重要线索。（解锁信息）",
              "severity": "info"
            },
            {
              "op": "log_event",
              "event_type": "ACTION",
              "message": "{role} 阅读了金藏的日记"
            }
          ]
        }
      ],
      "default_visibility": "hidden"
    },
    {
